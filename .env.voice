HRIP_ENV_FILE=.env.voice

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hrip
POSTGRES_USER=hrip
POSTGRES_PASSWORD=hrip
DATABASE_URL=postgresql+asyncpg://hrip:hrip@postgres:5432/hrip
REDIS_URL=redis://redis:6379/0

JWT_ISSUER=hrip-gateway
JWT_AUDIENCE=hrip-analyst
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
JWT_CLOCK_SKEW_SECONDS=60
JWT_PRIVATE_KEY_PATH=/app/keys/dev_rsa_private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/dev_rsa_public.pem

DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

THREAT_INTEL_CACHE_ONLY=true
THREAT_INTEL_TIMEOUT_SECONDS=2
VOICE_INGEST_ENABLED=true
WHISPER_ENABLED=false
ROBERTA_ENABLED=false
ROBERTA_TIMEOUT_MS=500
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_TIMEOUT_SECONDS=8
WHISPER_STARTUP_STRICT=false
MAX_ATTACHMENT_BYTES=5242880
MAX_VOICE_BYTES=10485760
VOICE_UPLOAD_DIR=data/uploads/voice
VOICE_ALLOWED_MIME_TYPES=audio/wav,audio/x-wav,audio/mpeg,audio/mp3,audio/ogg,audio/webm,audio/mp4,audio/aac,audio/flac
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=trustmail.ai@gmail.com
SMTP_PASSWORD=ffqbmxarnbrlpnaz
SMTP_FROM_EMAIL=trustmail.ai@gmail.com
SMTP_USE_TLS=true

NEXT_PUBLIC_API_URL=http://api:8000/api/v1
FRONTEND_GATEWAY_URL=http://gateway:8001
